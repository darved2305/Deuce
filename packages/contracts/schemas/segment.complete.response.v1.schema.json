{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "completed_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "final": {
      "type": "boolean"
    },
    "pts_end_us": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "pts_start_us": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "r2_key": {
      "pattern": "^seg\\/s_[A-Za-z0-9_-]+\\/[0-9]+\\.mp4$",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[A-Fa-f0-9]{64}$",
      "type": "string"
    },
    "starts_on_sync_sample": {
      "type": "boolean"
    }
  },
  "required": [
    "seq",
    "pts_start_us",
    "pts_end_us",
    "starts_on_sync_sample",
    "bytes",
    "sha256",
    "final",
    "r2_key",
    "completed_at"
  ],
  "type": "object"
}
