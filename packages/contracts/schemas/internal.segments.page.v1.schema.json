{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "final_seq": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "segments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "final": {
            "type": "boolean"
          },
          "pts_end_us": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "pts_start_us": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "r2_key": {
            "pattern": "^seg\\/s_[A-Za-z0-9_-]+\\/[0-9]+\\.mp4$",
            "type": "string"
          },
          "seq": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[A-Fa-f0-9]{64}$",
            "type": "string"
          },
          "starts_on_sync_sample": {
            "type": "boolean"
          }
        },
        "required": [
          "seq",
          "pts_start_us",
          "pts_end_us",
          "starts_on_sync_sample",
          "bytes",
          "sha256",
          "final",
          "r2_key"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "segments",
    "final_seq"
  ],
  "type": "object"
}
