{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "maxLength": 24,
      "minLength": 1,
      "type": "string"
    },
    "match_id": {
      "pattern": "^m_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "rematch_of": {
      "pattern": "^ch_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "round_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "hit_event_id": {
            "pattern": "^e_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "pick": {
            "anyOf": [
              {
                "enum": [
                  "F1",
                  "F2",
                  "F3",
                  "M1",
                  "M2",
                  "M3",
                  "B1",
                  "B2",
                  "B3",
                  "S",
                  "L"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "maximum": 1000,
            "minimum": 0,
            "type": "integer"
          },
          "reaction_ms": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "enum": [
              "exact",
              "adjacent",
              "wrong",
              "too_slow"
            ],
            "type": "string"
          }
        },
        "required": [
          "hit_event_id",
          "pick",
          "reaction_ms",
          "verdict",
          "points"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "rounds": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "contact_ms": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "contact_sigma_ms": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "hit_event_id": {
            "pattern": "^e_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "ladder_us": {
            "items": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "landing_event_id": {
            "pattern": "^e_[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "hit_event_id",
          "landing_event_id",
          "contact_ms",
          "contact_sigma_ms",
          "ladder_us"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 3,
      "type": "array"
    },
    "score": {
      "maximum": 100000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "match_id",
    "rounds",
    "score",
    "round_results"
  ],
  "type": "object"
}
