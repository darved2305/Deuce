{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "caption": {
            "anyOf": [
              {
                "maxLength": 140,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "match_id": {
            "pattern": "^m_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "owner": {
            "additionalProperties": false,
            "properties": {
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "player_id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              }
            },
            "required": [
              "player_id",
              "display_name"
            ],
            "type": "object"
          },
          "post_id": {
            "pattern": "^po_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "summary": {
            "additionalProperties": false,
            "properties": {
              "duration_ms": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hit_count": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landing_points_m": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "x_m": {
                      "type": "number"
                    },
                    "y_m": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x_m",
                    "y_m"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "landings_in": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landings_out": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "longest_rally_ms": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "owner_display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rally_count": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "top_coach_points": {
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "type": "array"
              }
            },
            "required": [
              "title",
              "duration_ms",
              "rally_count",
              "hit_count",
              "landings_in",
              "landings_out",
              "longest_rally_ms",
              "top_coach_points",
              "landing_points_m",
              "owner_display_name"
            ],
            "type": "object"
          }
        },
        "required": [
          "post_id",
          "match_id",
          "owner",
          "created_at",
          "caption",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "type": "object"
}
