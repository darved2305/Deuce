              "required": [
                "median_interval_us",
                "min_us",
                "max_us",
                "gaps",
                "vfr"
              ],
              "type": "object"
            },
            "rotation": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            "width": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "width",
            "height",
            "rotation",
            "fps_nominal",
            "duration_ms",
            "pts",
            "codec",
            "has_audio",
            "audio_rate_hz",
            "device",
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        "sport": {
          "enum": [
            "badminton",
            "table_tennis",
            "tennis",
            "free_play"
