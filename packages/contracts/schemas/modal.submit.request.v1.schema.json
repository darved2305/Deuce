                        }
                      ],
                      "type": "array"
                    },
                    "near_right": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    }
                  },
                  "required": [
                    "near_left",
                    "near_right",
                    "far_right",
                    "far_left"
                  ],
                  "type": "object"
                },
                "template": {
                  "type": "string"
                }
              },
              "required": [
                "method",
                "plane",
                "template",
                "points_px",
                "frame_ms"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "frame_ms": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "method": {
                  "type": "string"
                },
                "plane": {
                  "const": "floor",
                  "type": "string"
                },
                "points_px": {
                  "additionalProperties": false,
                  "properties": {
                    "far_left": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    },
                    "far_right": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    },
                    "near_left": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    },
                    "near_right": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
