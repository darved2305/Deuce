                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    },
                    "far_right": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    },
                    "near_left": {
                      "items": false,
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
