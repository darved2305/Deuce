    "analysis_id": {
      "pattern": "^a_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "r2_key": {
      "pattern": "^orig\\/s_[A-Za-z0-9_-]+\\/source\\.mp4$",
      "type": "string"
    },
