{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "format": {
            "enum": [
              "singles",
              "doubles",
              "none"
            ],
            "type": "string"
          },
          "match_id": {
            "pattern": "^m_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "ruleset": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          },
          "score": {
            "additionalProperties": false,
            "properties": {
              "games": {
                "items": {
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              }
            },
            "required": [
              "games"
            ],
            "type": "object"
          },
          "sport": {
            "enum": [
              "badminton",
              "table_tennis",
              "tennis",
              "free_play"
            ],
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "enum": [
                  "awaiting_upload",
                  "uploaded",
                  "queued",
                  "processing",
                  "partial",
                  "finalizing",
                  "completed",
                  "failed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "match_id",
          "sport",
          "format",
          "ruleset",
          "created_at",
          "state",
          "score"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "type": "object"
}
