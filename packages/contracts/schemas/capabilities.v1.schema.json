              "enum": [
                "unknown",
                "pass",
                "unmet",
                "could-not-run"
              ],
              "type": "string"
            },
            "tier": {
              "enum": [
                "core",
                "assisted",
                "experimental",
                "unsupported"
              ],
              "type": "string"
            }
          },
          "required": [
            "tier",
            "status"
          ],
          "type": "object"
        },
        "reviews": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "pass",
                "unmet",
