{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clip": {
      "additionalProperties": false,
      "properties": {
        "accepted_file_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "file": {
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "rotation": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "time_base": {
          "type": "string"
        },
        "video_stream_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "accepted_file_sha256",
        "width",
        "height"
      ],
      "type": "object"
    },
    "frame_count_in_range": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "frames": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ball": {
            "anyOf": [
              {
                "items": false,
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "t_ms": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "t_us": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "t_us",
          "ball"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "labelled_at": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "labelled_by": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "removals_approved_by": {
          "type": "string"
        },
        "removed_frames_t_us": {
          "items": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "observed",
            "candidate",
            "inferred",
            "user"
          ],
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "validated_by": {
          "type": "string"
        }
      },
      "required": [
        "state",
        "engine_version"
      ],
      "type": "object"
    },
    "range_us": {
      "description": "Section 0 time range [start, end]. Producers enforce start <= end with Zod; JSON Schema preserves the tuple shape but cannot compare its items.",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "schema": {
      "const": "elevate.trail_labels.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "clip",
    "provenance",
    "range_us",
    "frame_count_in_range",
    "frames"
  ],
  "type": "object"
}
