# Source of truth for environment variable NAMES (D-010). Values never go in git.
# Add a name here in the same PR that first reads it.

# Supabase (Person 3). The app only ever gets the URL + publishable key (sb_publishable_...).
# Inside Edge Functions, SUPABASE_URL / SUPABASE_PUBLISHABLE_KEYS / SUPABASE_SECRET_KEYS / SUPABASE_JWKS
# are built in; custom function secrets must NOT start with SUPABASE_. Legacy anon/service_role keys
# are being retired: use publishable/secret keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # sb_secret_...: server only (insights job, CI); never in the app
SUPABASE_PROJECT_REF=             # also used by .mcp.json (dev project, read-only)
SUPABASE_ACCESS_TOKEN=            # CI deploys only
SUPABASE_DB_PASSWORD=             # CI migrations only

# Cloudflare R2 (Person 3 signs; Person 1 reads/writes via Modal secrets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_WRITES_ENABLED=true

# Modal (Person 1 operates; CI deploy would use MODAL_TOKEN_ID / MODAL_TOKEN_SECRET)
MODAL_SUBMIT_URL=                 # Person 1's submit endpoint, called by Person 3
MODAL_SUBMIT_TOKEN=               # bearer token checked by submit
INTERNAL_API_TOKEN=               # X-Internal-Token Modal sends to /internal routes

# Optional captions (Person 3)
CF_ACCOUNT_ID=
CF_WORKERS_AI_TOKEN=
